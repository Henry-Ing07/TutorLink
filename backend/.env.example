# Copiar a .env y ajustar. El archivo .env NUNCA se sube al repositorio (DoD punto 7).

# Clave para firmar los tokens de sesión (JWT). Generar una larga y aleatoria:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria

# Base de datos. Desarrollo: SQLite. Producción: MySQL.
#   mysql+pymysql://usuario:clave@host:3306/tutorlink?charset=utf8mb4
DATABASE_URL=sqlite:///tutorlink.db

# Costo de bcrypt para contraseñas (RNF-03 exige 12 o más).
BCRYPT_ROUNDS=12

# Horas de vigencia del token de sesión.
TOKEN_HORAS=168

# Desfase horario de la operación respecto a UTC (Colombia = -5).
UTC_OFFSET_HORAS=-5

# Proveedor de notificaciones: "bandeja" (la app consulta sus avisos).
NOTIFICADOR=bandeja

# Intentos máximos de entrega de un aviso antes de marcarlo como fallido.
NOTIFICACION_MAX_INTENTOS=5
