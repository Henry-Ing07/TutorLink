<?xml version="1.0" encoding="utf-8"?>
<!-- El token y los horarios (con datos de menores) no salen del teléfono:
     ni copia en la nube ni transferencia a otro dispositivo. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
